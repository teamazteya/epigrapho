msgid "You must log out in order to change/reset server URLs."
msgstr "Tienes que cerrar sesión para cambiar o restablecer las direcciones de servidor."

#: src/strings.ts:1074
msgid "You subscribed to Epigrapho Pro on {date}. Verify this subscription?"
msgstr "Te suscribiste a Epigrapho Pro el {date}. ¿Verificamos esta suscripción?"

#: src/strings.ts:719
msgid "You subscribed to Epigrapho Pro on Android Phone/Tablet using Google In App Purchase."
msgstr "Te suscribiste a Epigrapho Pro en un teléfono o tableta Android con la compra dentro de la app de Google."

#: src/strings.ts:712
msgid "You subscribed to Epigrapho Pro on iOS using Apple In App Purchase. You can cancel anytime with your iTunes Account settings."
msgstr "Te suscribiste a Epigrapho Pro en iOS con la compra dentro de la app de Apple. Puedes cancelar cuando quieras desde los ajustes de tu cuenta de iTunes."

#: src/strings.ts:725
msgid "You subscribed to Epigrapho Pro on the Web/Desktop App."
msgstr "Te suscribiste a Epigrapho Pro en la app web o de escritorio."

#: src/strings.ts:731
msgid "You subscribed to Epigrapho Pro using a gift card."
msgstr "Te suscribiste a Epigrapho Pro con una tarjeta de regalo."

#: src/strings.ts:706
msgid "You were awarded a subscription to Epigrapho Pro by Azteya."
msgstr "Azteya te otorgó una suscripción a Epigrapho Pro."

#: src/strings.ts:468
msgid "You will be logged out from all your devices"
msgstr "Se cerrará tu sesión en todos tus dispositivos"

#: src/strings.ts:2018
msgid "You will receive instructions on how to recover your account on this email"
msgstr "En este correo recibirás las instrucciones para recuperar tu cuenta"

#: src/strings.ts:467
msgid "Your account email will be changed without affecting your subscription or any other settings."
msgstr "El correo de tu cuenta cambiará sin afectar tu suscripción ni ningún otro ajuste."

#: src/strings.ts:2084
msgid "Your account has been recovered."
msgstr "Tu cuenta fue recuperada."

#: src/strings.ts:502
#: src/strings.ts:1853
msgid "Your account is now 100% secure against unauthorized logins."
msgstr "Tu cuenta ya está 100% protegida contra inicios de sesión no autorizados."

#: src/strings.ts:2023
msgid "Your account password must be strong & unique."
msgstr "La contraseña de tu cuenta debe ser fuerte y única."

#: src/strings.ts:1040
msgid "Your account will be downgraded in {days} days"
msgstr "Tu cuenta bajará de plan en {days} días"

#: src/strings.ts:1084
msgid "Your account will be permanently deleted along with all your data, login credentials, and subscription information. This action is IRREVERSIBLE. Make sure you have saved a backup of your notes before proceeding."
msgstr "Tu cuenta se borrará para siempre, junto con todos tus datos, credenciales e información de suscripción. Esto NO SE PUEDE DESHACER. Guarda un respaldo de tus notas antes de seguir."

#: src/strings.ts:966
msgid "Your archive"
msgstr "Tu archivo"

#: src/strings.ts:2665
msgid "Your archive is empty"
msgstr "Tu archivo está vacío"

#: src/strings.ts:2096
msgid "Your backup is ready to download"
msgstr "Tu respaldo está listo para descargar"

#: src/strings.ts:1711
msgid "Your changes could not be saved"
msgstr "No se pudieron guardar tus cambios"

#: src/strings.ts:1943
msgid "Your changes have been saved and will be reflected after the app has refreshed."
msgstr "Tus cambios se guardaron y aparecerán cuando la app se actualice."

#: src/strings.ts:2276
msgid "Your current 2FA method is {method}"
msgstr "Tu método actual de 2FA es {method}"

#: src/strings.ts:2777
msgid "Your current subscription does not allow changing plans"
msgstr "Tu suscripción actual no permite cambiar de plan"

#: src/strings.ts:1968
msgid "Your data recovery key is basically a hashed version of your password (plus some random salt). It can be used to decrypt your data for re-encryption."
msgstr "La llave de recuperación de tus datos es, en el fondo, una versión cifrada de tu contraseña (más algo de sal aleatoria). Sirve para descifrar tus datos y volver a cifrarlos."

#: src/strings.ts:2021
msgid "Your data recovery key will be used to decrypt your data"
msgstr "Se usará la llave de recuperación de tus datos para descifrarlos"

#: src/strings.ts:2685
msgid "Your data remains 100% accessible regardless of what plan you are on. That includes your notes, notebooks, attachments, and anything else you might have created."
msgstr "Tus datos siguen 100% accesibles sin importar el plan que tengas. Eso incluye tus notas, libretas, adjuntos y cualquier otra cosa que hayas creado."

#: src/strings.ts:1951
msgid "Your email has been confirmed."
msgstr "Tu correo quedó confirmado."

#: src/strings.ts:2676
msgid "Your email has been confirmed. You can now securely sync your encrypted notes across all devices."
msgstr "Tu correo quedó confirmado. Ya puedes sincronizar tus notas cifradas en todos tus dispositivos."

#: src/strings.ts:776
msgid "Your email is not confirmed. Please confirm your email address to change account password."
msgstr "Tu correo no está confirmado. Confírmalo para cambiar la contraseña de la cuenta."

