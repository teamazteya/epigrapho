msgstr "Tu nombre completo"

#: src/strings.ts:965
msgid "Your monographs"
msgstr "Tus monográficos"

#: src/strings.ts:1318
msgid "Your name is stored 100% end-to-end encrypted and only visible to you."
msgstr "Tu nombre se guarda 100% cifrado de extremo a extremo y solo tú lo ves."

#: src/strings.ts:572
msgid "Your note will be unencrypted and removed from the vault."
msgstr "Tu nota quedará sin cifrar y saldrá de la bóveda."

#: src/strings.ts:963
